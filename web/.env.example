# Copie ce fichier en .env.local et remplis-le (Supabase → Project Settings → API).
# Sans ces deux lignes, le jeu tourne en mode démo locale.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Uniquement pour `npm run seed`, jamais dans Vercel ni dans le code du front.
SUPABASE_SERVICE_ROLE_KEY=
