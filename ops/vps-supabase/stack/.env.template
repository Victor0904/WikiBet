# Supabase allégé d'Aurelys : modèle du fichier .env (aucun secret ici).
# Le vrai .env est écrit par scripts/00-gen-secrets.sh (chmod 600, ignoré par git), puis complété à la main
# pour les lignes marquées « À FOURNIR ». Relancer 00-gen-secrets.sh ne remplace jamais une valeur déjà remplie.
# Valeurs avec guillemets, accolades ou espaces : entre apostrophes, 'comme ceci'.

############ Machine (dépend de l'organisation du VPS : voir INTEGRATION-VPS.md)
# Sous-domaine DuckDNS de l'API, sans https:// (ex. aurelys-api.duckdns.org). À FOURNIR.
API_DOMAIN=CHANGER.duckdns.org
# Port local du gateway (127.0.0.1 seulement), vers lequel le reverse proxy envoie https://API_DOMAIN. À FIXER avec le VPS.
API_GW_PORT=8100
# Dossier des fonctions du dépôt (web/supabase/functions), relatif au dossier stack/ ou absolu.
FUNCTIONS_SRC=../../../web/supabase/functions

############ Secrets générés par 00-gen-secrets.sh (ne pas remplir à la main)
POSTGRES_PASSWORD=
# HS256, 32 caractères au moins. Recommandé : le « Legacy JWT secret » du projet Cloud (00-gen-secrets.sh --jwt-cloud),
# pour que les sessions ouvertes restent valides après la bascule.
JWT_SECRET=
# JWT signés avec JWT_SECRET, valables 10 ans. ANON_KEY va dans Vercel (VITE_SUPABASE_ANON_KEY).
ANON_KEY=
SERVICE_ROLE_KEY=
# Vérification des jetons (00-gen-secrets.sh, à partir de JWT_SECRET et de stack/cloud-jwks.json) : le Cloud signe
# les sessions en ES256 (clé publique seulement), le VPS en HS256. JWT_JWKS : rest, realtime, functions ;
# JWT_KEYS : auth (signe en HS256, vérifie les deux). Les sessions ouvertes sur le Cloud restent donc valides.
JWT_JWKS=
JWT_KEYS=
# Accès « dashboard » du gateway (route vers studio, non lancé ici).
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
# Realtime : 64 caractères au moins.
SECRET_KEY_BASE=
# Realtime : 16 caractères exactement.
REALTIME_DB_ENC_KEY=
# Supavisor et postgres-meta (services non lancés) : générés quand même, le compose officiel les cite.
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
# Secret du moteur : en-tête x-tick-secret envoyé par pg_cron (Vault « aurelys_tick ») et vérifié par la fonction.
# 03-restore.sh recrée le secret Vault avec cette valeur.
TICK_SECRET=

############ À FOURNIR
# Discord : portail développeur Discord → l'application d'Aurelys → OAuth2.
DISCORD_ENABLED=true
DISCORD_CLIENT_ID=
DISCORD_SECRET=
# Cloudflare Turnstile : clé secrète (la clé de site reste VITE_TURNSTILE_SITE_KEY dans Vercel).
# Sans clé : CAPTCHA_ENABLED=false (n'importe quel robot peut alors créer des parties anonymes).
CAPTCHA_ENABLED=true
TURNSTILE_SECRET=
# Clé privée VAPID des notifications de liquidation, au format JWK, entre apostrophes : '{"kty":"EC",...}'.
# Vide : pas de notification Web Push (le reste fonctionne).
VAPID_PRIVATE=

############ Auth (GoTrue)
# Adresse du site et adresses de retour autorisées (Discord revient sur /jouer). Reprendre celles de
# Supabase Cloud → Authentication → URL Configuration, séparées par des virgules.
SITE_URL=https://aurelys-trade.vercel.app
ADDITIONAL_REDIRECT_URLS=https://aurelys-trade.vercel.app/**
API_EXTERNAL_URL=https://${API_DOMAIN}/auth/v1
SUPABASE_PUBLIC_URL=https://${API_DOMAIN}
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
# Comptes « pseudo + mot de passe » : adresse interne déjà confirmée, aucun e-mail envoyé.
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
# Parties sans compte (signInAnonymously dans web/src/api.js) : indispensable.
ENABLE_ANONYMOUS_USERS=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
# Pas de SMTP : aucun e-mail ne part (SMTP_HOST vide). SMTP_PORT doit rester un nombre, sinon GoTrue refuse de démarrer.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############ Base et API
POSTGRES_HOST=db
POSTGRES_DB=postgres
# Port interne au réseau Docker : jamais publié sur la machine.
POSTGRES_PORT=5432
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
# Le routeur des fonctions vérifie le JWT (clé anon ou session) avant la fonction aurelys, comme sur Cloud.
FUNCTIONS_VERIFY_JWT=true

############ Cités par le compose officiel, inutilisés (services non lancés). Ne pas supprimer : sans eux,
# docker compose refuse le fichier (ports vides) ou affiche des avertissements.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
STUDIO_DEFAULT_ORGANIZATION=Aurelys
STUDIO_DEFAULT_PROJECT=Aurelys
OPENAI_API_KEY=
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=aurelys
POOLER_DB_POOL_SIZE=5
GLOBAL_S3_BUCKET=stub
REGION=local
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
IMGPROXY_AUTO_WEBP=true
